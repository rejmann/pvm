#!/bin/sh
# Entrypoint of the `go` service. Creates the working directories and runs the
# command as the owner of the mounted project, so everything written to dist/
# and .local/ belongs to the host user — without asking the host for its uid.
set -e

mkdir -p dist .local/bin .local/go .local/go-cache .local/apt/archives

owner="$(stat -c %u:%g /src)"
if [ "$(id -u)" = 0 ] && [ "$owner" != "0:0" ]; then
	chown "$owner" dist .local .local/bin .local/go .local/go-cache
	exec su-exec "$owner" "$@"
fi
exec "$@"
